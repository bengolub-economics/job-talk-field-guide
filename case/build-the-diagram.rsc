3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Trace one path before the full system. · The Job Talk Field Guide"}],["$","meta","1",{"name":"description","content":"When a model has many connected parts, first trace one path from an input to an outcome. Add the other connections after the audience understands that path."}],["$","link","2",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/job-talk-field-guide/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["case","build-the-diagram"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"case","fallback":["$","main",null,{"id":"main","className":"reading-page","children":["$","header",null,{"className":"reading-header","children":[["$","p",null,{"className":"eyebrow","children":"PAGE NOT FOUND"}],["$","h1",null,{"children":["Back to the",["$","br",null,{}],["$","em",null,{"children":"main argument."}]]}],["$","p",null,{"className":"lead","children":"That case isn’t in this gallery."}],["$","a",null,{"className":"text-link","href":"/job-talk-field-guide/","children":"Browse all cases →"}]]}]}],"children":["$","$La",null,{"resetKey":"[\"case\",\"slug|build-the-diagram|d\"]","fallback":["$","main",null,{"id":"main","className":"reading-page","children":["$","header",null,{"className":"reading-header","children":[["$","p",null,{"className":"eyebrow","children":"PAGE NOT FOUND"}],["$","h1",null,{"children":["Back to the",["$","br",null,{}],["$","em",null,{"children":"main argument."}]]}],["$","p",null,{"className":"lead","children":"That case isn’t in this gallery."}],["$","a",null,{"className":"text-link","
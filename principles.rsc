1:["$","main",null,{"className":"reading-page","id":"main","children":[["$","a",null,{"className":"back-link","href":"/job-talk-field-guide/","children":"← Back to the gallery"}],["$","header",null,{"className":"reading-header","children":[["$","p",null,{"className":"eyebrow","children":"THE ADVICE BEHIND THE EXAMPLES"}],["$","h1",null,{"children":["Holding their attention",["$","br",null,{}],["$","em",null,{"children":"is not an easy problem."}]]}],["$","p",null,{"className":"lead","children":"The essay’s advice is about understanding under limited attention. These are the decisions the gallery makes visible."}]]}],["$","div",null,{"className":"principle-grid","children":[["$","section","Design your talk for that persuadable voter.",{"className":"principle-block","children":[["$","span",null,{"children":"01"}],["$","h2",null,{"children":"Design your talk for that persuadable voter."}],["$","p",null,{"children":"The listener is choosing whether to follow. A specialist may fill in what you leave unsaid; the persuadable economist outside your field often cannot. Make the question and the contribution understandable before the machinery."}],["$","ul",null,{"children":[["$","li","question-before-model",{"children":["$","a",null,{"href":"/job-talk-field-guide/case/question-before-model","children":["02"," / ","Explain the question before the model."," →"]}]}]]}]]}],["$","section","Put conclusions before details and caveats.",{"className":"principle-block","children":[["$","span",null,{"children":"02"}],["$","h2",null,{"children":"Put conclusions before details and caveats."}],["$","p",null,{"children":"A model should arrive with a purpose; a results slide with a finding. The details then answer a question the audience already has. A clear title must still respect what the evidence establishes."}],["$","ul",null,{"children":[["$","li","title-the-finding",{"children":["$","a",null,{"href":"/job-talk-field-guide/case/title-the-finding","children":["06"," / ","Put the finding in the title."," →"]}]}],["$","li","claim-and-boundary",{"children":["$","a",null,{"href":"/job-talk-field-guide/case/claim-and-boundary","children":["09"," / ","Explain what each limitation qualifies."," →"]}]}]]}]]}],["$","section","Put definitions where you use them, or remind people.",{"className":"principle-block","children":[["$","span",null,{"children":"03"}],["$","h2",null,{"children":"Put definitions where you use them, or remind people."}],["$","p",null,{"children":"A definition seven slides ago is not a definition on this slide. Keep meanings near the symbols, and choose names that help the listener remember them. At section breaks, restore the argument, not just its outline."}],["$","ul",null,{"children":[["$","li","define-at-use",{"children":["$","a",null,{"href":"/job-talk-field-guide/case/define-at-use","children":["03"," / ","Put the meaning next to the symbol."," →"]}]}],["$","li","mnemonic-notation",{"children":["$","a",null,{"href":"/job-talk-field-guide/case/mnemonic-notation","children":["10"," / ","Choose notation that helps people remember."," →"]}]}]]}]]}],["$","section","Build up from the simple version.",{"className":"principle-block","children":[["$","span",null,{"children":"04"}],["$","h2",null,{"children":"Build up from the simple version."}],["$","p",null,{"children":"Give the audience a small working example before the general statement. Explain exactly what carries over, and retain the conditions the general result needs."}],["$","ul",null,{"children":[["$","li","start-with-two",{"children":["$","a",null,{"href":"/job-talk-field-guide/case/start-with-two","children":["07"," / ","Start with the smallest useful example."," →"]}]}]]}]]}],["$","section","Let the slide unfold.",{"className":"principle-block","children":[["$","span",null,{"children":"05"}],["$","h2",null,{"children":"Let the slide unfold."}],["$","p",null,{"children":"Complexity is not always a defect. It matters how much arrives at once and how long the room has to absorb it. Teach each piece, then let the whole picture do its work."}],"$Ld"]}],"$Le","$Lf","$L10"]}],"$L11"]}]
d:["$","ul",null,{"children":[["$","li","teach-the-picture",{"children":["$","a",null,{"href":"/job-talk-field-guide/case/teach-the-picture","children":["04"," / ","Explain how to read the figure."," →"]}]}],["$","li","build-the-diagram",{"children":["$","a",null,{"href":"/job-talk-field-guide/case/build-the-diagram","children":["08"," / ","Trace one flow before the full system."," →"]}]}]]}]
e:["$","section","Minimize tables with lots of numbers!",{"className":"principle-block","children":[["$","span",null,{"children":"06"}],["$","h2",null,{"children":"Minimize tables with lots of numbers!"}],["$","p",null,{"children":"A table preserves values but can hide the comparison. Draw the comparison you need, keep its units and uncertainty, and make the complete source available. Do not improve the headline by discarding a troublesome result."}],["$","ul",null,{"children":[["$","li","show-the-comparison",{"children":["$","a",null,{"href":"/job-talk-field-guide/case/show-the-comparison","children":["01"," / ","Make the comparison visible."," →"]}]}],["$","li","keep-the-uncertainty",{"children":["$","a",null,{"href":"/job-talk-field-guide/case/keep-the-uncertainty","children":["05"," / ","Visualize estimates and uncertainty whenever possible."," →"]}]}]]}]]}]
f:["$","section","Build the 20 slides, then go through them slower.",{"className":"principle-block","children":[["$","span",null,{"children":"07"}],["$","h2",null,{"children":"Build the 20 slides, then go through them slower."}],["$","p",null,{"children":"For a long job talk, plan roughly twenty distinct core displays. An animation build is not another display. Aim to finish the introduction around ten minutes, reach main results by thirty to thirty-five, and convey the essential contribution by sixty. Rehearse sections that can expand or contract."}],["$","ul",null,{"children":[]}]]}]
10:["$","section","Be bigger than your paper.",{"className":"principle-block","children":[["$","span",null,{"children":"08"}],["$","h2",null,{"children":"Be bigger than your paper."}],["$","p",null,{"children":"The point is to present yourself as a credible researcher. A concrete account of what the paper establishes, where it stops, and what the next paper would need is stronger than either an overclaim or a list of apologies."}],["$","ul",null,{"children":[["$","li","claim-and-boundary",{"children":["$","a",null,{"href":"/job-talk-field-guide/case/claim-and-boundary","children":["09"," / ","Explain what each limitation qualifies."," →"]}]}]]}]]}]
